\begin{tikzpicture}[
    font=\normalsize,
    party/.style={draw=DarkOrchid, fill=Thistle!60, rounded corners=3pt, minimum width=3.0cm, minimum height=0.75cm,
                  font=\normalsize\bfseries, align=center},
    msg/.style={-{Stealth[length=2.2mm]}, thick, DarkOrchid},
    lab/.style={above, font=\footnotesize, fill=white, inner sep=1pt},
    phase/.style={draw=Orchid, fill=Lavender, rounded corners=2pt, font=\footnotesize\bfseries, inner sep=2pt},
    loc/.style={font=\footnotesize, align=left}
  ]
  \node[party] (U) at (0,0)    {Користувач\\[-2pt]\footnotesize(клієнт)};
  \node[party] (S) at (9.0,0)  {Сервер\\[-2pt]\footnotesize видавець $=$ верифікатор};
  \draw[densely dotted, Plum] (U.south) -- (0,-8.7);
  \draw[densely dotted, Plum] (S.south) -- (9.0,-8.7);
  \node[phase] at (4.5,-0.95) {Видача (issue): з автентифікацією, раз на добу};
  \draw[msg] (0.1,-1.75) -- node[lab] {ідентифікатор $\mathrm{UID}$ (звичайний вхід)} (8.9,-1.75);
  \node[loc, anchor=east] at (8.85,-2.55) {$t\xleftarrow{\$}\mathbb{Z}_q,\ U\xleftarrow{\$}\mathbb{G}$,\\
         $V = W\,U^{x_0+x_1t}\prod_i M_i^{y_i}$};
  \draw[msg] (8.9,-3.45) -- node[lab] {$(t,U,V)$ і доведення $\pi_I$ коректної видачі} (0.1,-3.45);
  \node[loc, anchor=west] at (0.15,-3.95) {перевірити $\pi_I$ за публічними $(C_W, I)$};
  \node[phase] at (4.5,-4.7) {Пред'явлення (present): анонімно, скільки завгодно разів};
  \node[loc, anchor=west] at (0.15,-5.5) {$z\xleftarrow{\$}\mathbb{Z}_q$:\ $C_{x_0}=G_{x_0}^zU,\ C_{x_1}=G_{x_1}^zU^t$,\\
         $C_{y_i}=G_{y_i}^zM_i,\ C_V=G_V^zV$;\ шифротекст $E$};
  \draw[msg] (0.1,-6.45) -- node[lab] {$\bigl(C_{x_0},C_{x_1},\{C_{y_i}\},C_V,E,\pi\bigr)$} (8.9,-6.45);
  \node[loc, anchor=east] at (8.85,-7.25) {$Z \gets C_V\big/\bigl(W\,C_{x_0}^{x_0}C_{x_1}^{x_1}\prod_i C_{y_i}^{y_i}\bigr)$,\\
         прийняти, якщо $\pi$ перевіряється з цим $Z$};
  \node[loc, anchor=west, DarkOrchid, text width=7.6cm] at (0.15,-8.2)
       {нове $z$ щоразу $\Rightarrow$ пред'явлення не зв'язуються між собою і з видачею (unlinkability)};
\end{tikzpicture}
