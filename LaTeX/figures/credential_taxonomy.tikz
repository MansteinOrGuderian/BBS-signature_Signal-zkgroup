% Two families of anonymous credentials and where Signal's zkgroup and BBS sit.
% Requires: \usepackage[svgnames]{xcolor}, \usetikzlibrary{positioning}
\begin{tikzpicture}[
    font=\small,
    node distance=4mm and 4mm,
    root/.style={draw=DarkOrchid, fill=Thistle, rounded corners=3pt, font=\small\bfseries, align=center,
                 minimum width=4cm},
    fam/.style={draw=DarkOrchid, fill=Thistle!45, rounded corners=3pt, align=center, text width=5.6cm},
    leaf/.style={draw=Plum, fill=white, rounded corners=2pt, align=left, font=\footnotesize, text width=5.6cm},
    hl/.style={leaf, draw=DarkOrchid, very thick, fill=Lavender},
    edge/.style={DarkOrchid, thick}
  ]
  \node[root] (R) {Анонімні повідомлення\\[-1pt]\footnotesize Chaum 1985};
  \node[fam, below left=7mm and -1.2cm of R]  (PV) {\textbf{Publicly verifiable}\\[-1pt]
        \footnotesize посвідчення $=$ цифровий підпис};
  \node[fam, below right=7mm and -1.2cm of R] (KV) {\textbf{Keyed-verification (KVAC)}\\[-1pt]
        \footnotesize посвідчення $=$ алгебраїчний MAC};
  \node[leaf, below=of PV] (pv1) {CL підписи (strong RSA, 2001)};
  \node[hl,   below=1.5mm of pv1] (pv2) {BBS / BBS+ (спарювання, $q$-SDH);\\ IETF CFRG draft, BLS12-381};
  \node[leaf, below=1.5mm of pv2] (pv3) {PS підписи, U-Prove, \dots};
  \node[leaf, below=of KV] (kv1) {CMZ: $\mathsf{MAC}_{\mathsf{GGM}}$, $\mathsf{MAC}_{\mathsf{DDH}}$ (2014)};
  \node[hl,   below=1.5mm of kv1] (kv2) {Chase-Perrin-Zaverucha (2020)\\ $\rightarrow$ Signal \texttt{zkgroup}};
  \node[leaf, below=1.5mm of kv2] (kv3) {BBS-MAC (BBDT 2016), IETF ARC, $\mu$CMZ/$\mu$BBS (2024), Tor Lox};
  \draw[edge] (R) -- (PV); \draw[edge] (R) -- (KV);
  \draw[edge] (PV) -- (pv1); \draw[edge] (KV) -- (kv1);
  \node[font=\footnotesize, align=center, below=5mm of $(pv3.south)!0.5!(kv3.south)$]
       {Загальний механізм: $\Sigma$-протоколи $+$ Фіат-Шамір для доказів знання/володіння відповідними даними};
\end{tikzpicture}
